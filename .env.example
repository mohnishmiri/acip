# Copy to .env and adjust. NEVER commit .env -- it is git-ignored.
# Every value below is a placeholder.

# ---------------------------------------------------------------- local ports
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5433

# ---------------------------------------------------------------- database
# PostgreSQL applies these ONLY when the data volume is first created. If you change them after
# the first `docker compose up`, either reset local data (`docker compose down -v`) or update the
# stored password -- see docs/local-setup.md "Troubleshooting". The default below matches the
# value docker-compose.yml uses when no .env exists, so creating .env later does not break login.
POSTGRES_DB=acip
POSTGRES_USER=acip
POSTGRES_PASSWORD=acip_local_dev

# ---------------------------------------------------------------- behaviour
# true = seed clearly-labelled DEMO DATA on first start (no Azure needed)
DEMO_MODE=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---------------------------------------------------------------- application user sign-in
# disabled (local only) | entra
APP_AUTH_MODE=disabled
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# App registration that exposes the ACIP API (audience)
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=
# SPA app registration used by the browser (public client, no secret)
ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# ---------------------------------------------------------------- cost collection (existing service principal)
# disabled | client_secret (local) | workload_identity (AKS) | managed_identity | default
AZURE_AUTH_MODE=disabled
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=<placeholder - set locally only>
# Path inside the containers (./config is mounted at /config) or inline JSON
AZURE_SUBSCRIPTIONS_CONFIG=/config/subscriptions.json
AZURE_STORAGE_ACCOUNT_URL=https://<storageaccount>.blob.core.windows.net
AZURE_COST_EXPORT_CONTAINER=cost-exports
# auto | azure_blob | local
#   local = read exports from a local folder. With Azure integration enabled you can fill that folder
#   without a storage account: Data Management -> "Pull to local exports" (Cost Details API), or
#   docker compose exec backend python -m app.cli export-local --months 3
EXPORT_SOURCE=auto
# Where the local export folder lives: "exports" (default, a Docker volume) or a host path such as
# ./data/exports to see the CSV files on your machine (data/ is git-ignored).
EXPORTS_HOST_PATH=exports
EXPORT_DISCOVERY_INTERVAL_MINUTES=60
