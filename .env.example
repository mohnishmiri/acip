# Copy to .env and adjust. NEVER commit .env -- it is git-ignored.
# Every value below is a placeholder.

# ---------------------------------------------------------------- local ports
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5433

# ---------------------------------------------------------------- database
POSTGRES_DB=acip
POSTGRES_USER=acip
POSTGRES_PASSWORD=change-me-local-only

# ---------------------------------------------------------------- behaviour
# true = seed clearly-labelled DEMO DATA on first start (no Azure needed)
DEMO_MODE=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---------------------------------------------------------------- application user sign-in
# disabled (local only) | entra
APP_AUTH_MODE=disabled
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# App registration that exposes the ACIP API (audience)
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=
# SPA app registration used by the browser (public client, no secret)
ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# ---------------------------------------------------------------- cost collection (existing service principal)
# disabled | client_secret (local) | workload_identity (AKS) | managed_identity | default
AZURE_AUTH_MODE=disabled
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=<placeholder - set locally only>
# Path inside the containers (./config is mounted at /config) or inline JSON
AZURE_SUBSCRIPTIONS_CONFIG=/config/subscriptions.json
AZURE_STORAGE_ACCOUNT_URL=https://<storageaccount>.blob.core.windows.net
AZURE_COST_EXPORT_CONTAINER=cost-exports
# auto | azure_blob | local
EXPORT_SOURCE=auto
EXPORT_DISCOVERY_INTERVAL_MINUTES=60
